<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>SAQUE — O agente de IA que arruma as duplas do seu clube de padel</title>
<meta name="description" content="O primeiro agente de IA que arruma duplas pelos grupos do WhatsApp do seu clube de padel. Reservas, sinal no Pix, lista de espera e atendimento 24/7. Sem app extra." />
<meta name="theme-color" content="#0A0A0A" />
<meta property="og:type" content="website" />
<meta property="og:title" content="SAQUE — Seu clube. Seus clientes. Seu WhatsApp." />
<meta property="og:description" content="O agente de IA que ARRUMA dupla sozinho no WhatsApp do seu clube de padel. 24/7." />
<meta property="og:locale" content="pt_BR" />
<meta name="twitter:card" content="summary_large_image" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=DM+Sans:wght@400;500;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0A0A0A;
    --bg-2:#0e0e0e;
    --ink:#ffffff;
    --mute:#8a8a8a;
    --line:#1d1d1d;
    --line-2:#2a2a2a;
    --acc:#CCFF00;
    --acc-2:#B6FF00;
    --wa-bg:#0B141A;
    --wa-head:#1F2C34;
    --wa-out:#005C4B;
    --wa-in:#1F2C34;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{
    background:var(--bg);color:var(--ink);
    font-family:'DM Sans',system-ui,-apple-system,sans-serif;
    -webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;
    overflow-x:hidden;
  }
  /* subtle grain */
  body::before{
    content:"";position:fixed;inset:0;pointer-events:none;z-index:1;opacity:.05;mix-blend-mode:overlay;
    background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)' opacity='1'/></svg>");
  }
  ::selection{background:var(--acc);color:#000}
  a{color:inherit;text-decoration:none}
  button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit}
  input,textarea,select{font-family:inherit}
  img,svg{display:block}

  /* Custom cursor (desktop only) */
  @media (hover:hover) and (pointer:fine){
    body{cursor:none}
    .cursor{position:fixed;top:0;left:0;width:14px;height:14px;background:var(--acc);border-radius:50%;pointer-events:none;z-index:9999;transform:translate(-50%,-50%);mix-blend-mode:difference;transition:width .2s,height .2s,background .2s}
    .cursor.lg{width:46px;height:46px;background:var(--acc)}
    a,button,input,select,textarea,label{cursor:none}
  }

  .display{font-family:'Archivo Black',sans-serif;font-weight:900;letter-spacing:-0.02em;line-height:0.88;text-transform:uppercase}
  .mono{font-family:'JetBrains Mono',monospace;font-weight:500;letter-spacing:0.02em}
  .eyebrow{font-family:'JetBrains Mono',monospace;font-size:11px;font-weight:500;letter-spacing:0.18em;text-transform:uppercase;color:var(--mute)}

  .wrap{max-width:1440px;margin:0 auto;padding:0 32px;position:relative;z-index:2}
  @media (max-width:720px){.wrap{padding:0 18px}}

  /* NAV */
  nav{position:fixed;top:0;left:0;right:0;z-index:50;padding:18px 32px;display:flex;align-items:center;justify-content:space-between;background:linear-gradient(180deg,rgba(10,10,10,.95),rgba(10,10,10,0));backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}
  nav .logo{display:flex;align-items:center;gap:10px;font-family:'Archivo Black',sans-serif;font-size:22px;letter-spacing:-0.02em}
  nav .logo .dot{width:10px;height:10px;background:var(--acc);border-radius:50%;box-shadow:0 0 14px var(--acc)}
  nav .status{display:flex;align-items:center;gap:8px;font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--mute);text-transform:uppercase;letter-spacing:0.16em}
  nav .status .pulse{width:6px;height:6px;border-radius:50%;background:var(--acc);animation:pulse 1.6s infinite}
  nav .cta{font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:0.16em;text-transform:uppercase;background:var(--acc);color:#000;padding:10px 16px;border-radius:999px;display:inline-flex;align-items:center;gap:8px;font-weight:700;transition:transform .2s ease}
  nav .cta:hover{transform:translateY(-1px)}
  @media (max-width:720px){nav{padding:14px 18px} nav .status{display:none} nav .logo{font-size:20px}}
  @keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.3;transform:scale(.7)}}

  /* HERO */
  .hero{position:relative;min-height:100vh;padding:140px 0 80px;overflow:hidden}
  .court-bg{position:absolute;inset:0;opacity:.18;mask-image:radial-gradient(ellipse at 50% 45%,black 30%,transparent 78%);-webkit-mask-image:radial-gradient(ellipse at 50% 45%,black 30%,transparent 78%);pointer-events:none}
  .hero-inner{position:relative;z-index:2}
  .badge{display:inline-flex;align-items:center;gap:10px;border:1px solid var(--line-2);background:rgba(204,255,0,.06);padding:8px 14px;border-radius:999px;font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.16em;text-transform:uppercase;color:var(--acc)}
  .badge .num{background:var(--acc);color:#000;padding:2px 8px;border-radius:999px;font-weight:700}
  .hero h1{font-size:clamp(56px,11vw,180px);margin-top:36px}
  .hero h1 .line{display:block;overflow:hidden}
  .hero h1 em{font-style:normal;color:var(--acc);position:relative}
  .hero h1 em::after{content:"";position:absolute;left:0;right:0;bottom:8%;height:6%;background:var(--acc);opacity:.18;filter:blur(8px)}
  .hero-meta{display:grid;grid-template-columns:1.4fr 1fr;gap:60px;align-items:end;margin-top:60px}
  .hero-sub{font-size:clamp(18px,1.65vw,23px);line-height:1.35;color:#cfcfcf;max-width:540px}
  .hero-sub strong{color:#fff;font-weight:700}
  .hero-sub .hi{color:var(--acc);font-weight:700}
  .hero-actions{display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-top:28px}
  .btn-primary{display:inline-flex;align-items:center;gap:12px;background:var(--acc);color:#000;padding:18px 26px;border-radius:999px;font-family:'Archivo Black',sans-serif;font-size:14px;letter-spacing:0.08em;text-transform:uppercase;transition:transform .25s cubic-bezier(.2,.8,.2,1),box-shadow .25s ease}
  .btn-primary:hover{transform:translate(-2px,-2px);box-shadow:6px 6px 0 #fff}
  .btn-primary .arrow{display:inline-block;width:18px;height:12px;position:relative;transition:transform .25s}
  .btn-primary .arrow::before{content:"";position:absolute;inset:0;background:#000;clip-path:polygon(0 45%,70% 45%,70% 0,100% 50%,70% 100%,70% 55%,0 55%)}
  .btn-primary:hover .arrow{transform:translateX(4px)}
  .btn-ghost{display:inline-flex;align-items:center;gap:10px;padding:18px 22px;border-radius:999px;border:1px solid #2a2a2a;font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:0.14em;text-transform:uppercase;color:#dcdcdc;transition:border-color .2s,color .2s}
  .btn-ghost:hover{border-color:var(--acc);color:var(--acc)}

  .hero-stats{display:flex;flex-direction:column;gap:18px;align-items:flex-start}
  .stat-row{display:flex;align-items:baseline;gap:16px;border-top:1px solid var(--line);padding-top:18px;width:100%}
  .stat-row .k{font-family:'Archivo Black',sans-serif;font-size:48px;line-height:1;color:#fff}
  .stat-row .k em{font-style:normal;color:var(--acc)}
  .stat-row .v{font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.14em;text-transform:uppercase;color:var(--mute);max-width:180px}
  @media (max-width:900px){
    .hero-meta{grid-template-columns:1fr;gap:40px}
    .hero{padding:120px 0 60px}
  }

  /* MARQUEE */
  .marquee{border-top:1px solid var(--line);border-bottom:1px solid var(--line);overflow:hidden;background:#0c0c0c;position:relative;z-index:3}
  .marquee-track{display:flex;gap:60px;padding:22px 0;animation:scroll 28s linear infinite;white-space:nowrap;align-items:center;width:max-content}
  .marquee-item{font-family:'Archivo Black',sans-serif;font-size:36px;letter-spacing:-0.01em;text-transform:uppercase;display:inline-flex;align-items:center;gap:60px}
  .marquee-item.alt{color:var(--acc)}
  .marquee-dot{width:10px;height:10px;background:var(--acc);border-radius:50%;flex-shrink:0}
  @keyframes scroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}

  /* SECTION header */
  section{position:relative}
  .section-head{display:grid;grid-template-columns:140px 1fr;gap:40px;align-items:start;margin-bottom:64px}
  .section-head .num{font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--mute);letter-spacing:0.16em;padding-top:18px;border-top:1px solid #fff;width:fit-content}
  .section-head h2{font-family:'Archivo Black',sans-serif;font-size:clamp(40px,6.2vw,96px);line-height:0.92;letter-spacing:-0.02em;text-transform:uppercase;max-width:14ch}
  .section-head h2 em{font-style:normal;color:var(--acc)}
  @media (max-width:720px){
    .section-head{grid-template-columns:1fr;gap:18px;margin-bottom:40px}
  }

  /* PROBLEM */
  .problem{padding:120px 0 80px}
  .problem-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line)}
  .problem-card{background:#0c0c0c;padding:40px 32px;min-height:340px;display:flex;flex-direction:column;justify-content:space-between;position:relative;transition:background .3s}
  .problem-card:hover{background:#101010}
  .problem-card .tag{font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:var(--mute)}
  .problem-card .big{font-family:'Archivo Black',sans-serif;font-size:clamp(26px,2.2vw,34px);line-height:1.04;text-transform:uppercase;margin-top:80px}
  .problem-card .big em{font-style:normal;color:var(--acc)}
  .problem-card .index{position:absolute;top:32px;right:32px;font-family:'Archivo Black',sans-serif;font-size:120px;color:#fff;opacity:.04;line-height:1}
  @media (max-width:900px){.problem-grid{grid-template-columns:1fr}}

  /* ★ AGENTE PROATIVO — A SEÇÃO ESTRELA ★ */
  .agent{padding:160px 0;background:var(--bg);position:relative;overflow:hidden}
  .agent::before{
    content:"";position:absolute;top:0;left:50%;transform:translateX(-50%);
    width:120%;height:600px;
    background:radial-gradient(ellipse,rgba(204,255,0,.12),transparent 60%);
    pointer-events:none;
  }
  .agent-tag{display:inline-flex;align-items:center;gap:10px;font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:var(--acc);background:rgba(204,255,0,.08);border:1px solid rgba(204,255,0,.3);padding:8px 14px;border-radius:999px}
  .agent-tag .dot{width:6px;height:6px;background:var(--acc);border-radius:50%;animation:pulse 1.4s infinite}
  .agent-head{max-width:1080px}
  .agent h2{font-family:'Archivo Black',sans-serif;font-size:clamp(48px,8vw,140px);line-height:0.88;text-transform:uppercase;letter-spacing:-0.025em;margin-top:24px}
  .agent h2 .strike{position:relative;display:inline-block}
  .agent h2 .strike::after{
    content:"";position:absolute;left:-4%;right:-4%;top:50%;height:8%;
    background:var(--acc);transform:translateY(-50%) rotate(-2deg);
    animation:strike 1.2s cubic-bezier(.2,.8,.2,1) forwards;
    transform-origin:left center;
  }
  .agent h2 em{font-style:normal;color:var(--acc);position:relative}
  .agent h2 em::after{content:"";position:absolute;left:0;right:0;bottom:8%;height:6%;background:var(--acc);opacity:.18;filter:blur(10px)}
  @keyframes strike{0%{transform:translateY(-50%) rotate(-2deg) scaleX(0)}100%{transform:translateY(-50%) rotate(-2deg) scaleX(1)}}
  .agent-sub{margin-top:32px;font-size:clamp(18px,1.5vw,22px);line-height:1.45;color:#cfcfcf;max-width:680px}
  .agent-sub strong{color:#fff;font-weight:700}
  .agent-sub .hi{color:var(--acc);font-weight:700}

  .agent-grid{display:grid;grid-template-columns:1.05fr 1fr;gap:80px;align-items:center;margin-top:80px}
  @media (max-width:1000px){.agent-grid{grid-template-columns:1fr;gap:60px}}

  /* WhatsApp Mockup */
  .phone{
    width:100%;max-width:420px;margin:0 auto;
    background:#000;border:10px solid #1a1a1a;border-radius:42px;
    padding:8px;box-shadow:0 60px 120px -30px rgba(204,255,0,.18),0 30px 60px -20px rgba(0,0,0,.6);
    position:relative;
    transform:rotate(-1.5deg);
    transition:transform .6s cubic-bezier(.2,.8,.2,1);
  }
  .phone:hover{transform:rotate(0deg) scale(1.02)}
  .phone .notch{position:absolute;top:14px;left:50%;transform:translateX(-50%);width:110px;height:24px;background:#000;border-radius:0 0 16px 16px;z-index:5}
  .phone-screen{background:var(--wa-bg);border-radius:34px;overflow:hidden;height:600px;display:flex;flex-direction:column;position:relative}
  .phone-screen::before{
    content:"";position:absolute;inset:0;
    background-image:
      radial-gradient(circle at 20% 30%,rgba(255,255,255,.012) 0,transparent 30%),
      radial-gradient(circle at 80% 70%,rgba(255,255,255,.012) 0,transparent 30%);
    pointer-events:none;
  }
  .wa-head{background:var(--wa-head);padding:42px 14px 12px;display:flex;align-items:center;gap:12px;border-bottom:1px solid rgba(255,255,255,.04);position:relative;z-index:2}
  .wa-back{color:#8696a0;font-size:18px}
  .wa-avatar{width:38px;height:38px;border-radius:50%;background:var(--acc);color:#000;display:flex;align-items:center;justify-content:center;font-family:'Archivo Black',sans-serif;font-size:14px}
  .wa-name{flex:1;line-height:1.1}
  .wa-name .n{font-size:15px;font-weight:600;color:#e9edef}
  .wa-name .s{font-size:11px;color:#8696a0;margin-top:2px}
  .wa-icons{color:#8696a0;display:flex;gap:18px;font-size:18px}
  .wa-body{flex:1;padding:18px 12px;display:flex;flex-direction:column;gap:10px;overflow-y:auto;position:relative;z-index:2}
  .wa-divider{align-self:center;background:rgba(255,255,255,.06);color:#8696a0;font-size:11px;padding:3px 12px;border-radius:8px;margin:6px 0}
  .bubble{max-width:78%;padding:8px 11px 7px;border-radius:8px;font-size:14px;line-height:1.32;color:#e9edef;position:relative;box-shadow:0 1px 0.5px rgba(0,0,0,.13)}
  .bubble .time{display:inline-block;font-size:10px;color:#8696a0;margin-left:6px;float:right;margin-top:6px;letter-spacing:.02em}
  .bubble.in{background:var(--wa-in);align-self:flex-start;border-top-left-radius:0}
  .bubble.in::before{content:"";position:absolute;top:0;left:-7px;width:8px;height:13px;background:var(--wa-in);clip-path:polygon(100% 0,100% 100%,0 0)}
  .bubble.out{background:var(--wa-out);align-self:flex-end;border-top-right-radius:0}
  .bubble.out::before{content:"";position:absolute;top:0;right:-7px;width:8px;height:13px;background:var(--wa-out);clip-path:polygon(0 0,100% 0,0 100%)}
  .bubble.in.saque{border-left:3px solid var(--acc)}
  .bubble .name{display:block;font-size:12px;font-weight:600;color:var(--acc);margin-bottom:2px}
  .bubble .check{display:inline-block;color:#53bdeb;font-size:11px;margin-left:4px}
  .typing{display:inline-flex;gap:3px;align-items:center}
  .typing span{width:6px;height:6px;background:#8696a0;border-radius:50%;animation:type 1.2s infinite}
  .typing span:nth-child(2){animation-delay:.2s}
  .typing span:nth-child(3){animation-delay:.4s}
  @keyframes type{0%,60%,100%{opacity:.3;transform:translateY(0)}30%{opacity:1;transform:translateY(-3px)}}

  .agent-features{display:flex;flex-direction:column;gap:14px}
  .agent-feature{background:#0e0e0e;border:1px solid var(--line);border-radius:18px;padding:26px 28px;display:flex;gap:20px;align-items:flex-start;transition:transform .3s ease,border-color .3s ease}
  .agent-feature:hover{transform:translateX(6px);border-color:var(--acc)}
  .agent-feature .ix{font-family:'Archivo Black',sans-serif;font-size:32px;color:var(--acc);line-height:1;min-width:50px}
  .agent-feature h4{font-family:'Archivo Black',sans-serif;font-size:18px;line-height:1.1;text-transform:uppercase;margin-bottom:6px;letter-spacing:-0.01em}
  .agent-feature p{color:#9c9c9c;font-size:14px;line-height:1.5}
  .agent-feature p strong{color:#fff;font-weight:600}

  /* SOLUTION (secondary, condensed) */
  .solution{padding:120px 0 80px;background:var(--bg)}
  .feat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
  .feat{background:#0e0e0e;border:1px solid var(--line);border-radius:16px;padding:26px;min-height:220px;display:flex;flex-direction:column;justify-content:space-between;transition:transform .3s ease,border-color .3s ease}
  .feat:hover{transform:translateY(-4px);border-color:#2c2c2c}
  .feat .icon{width:46px;height:46px;border-radius:12px;background:#000;border:1px solid var(--line);display:flex;align-items:center;justify-content:center;color:var(--acc);margin-bottom:18px}
  .feat .icon svg{width:22px;height:22px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
  .feat h3{font-family:'Archivo Black',sans-serif;font-size:18px;line-height:1.08;text-transform:uppercase;letter-spacing:-0.01em;margin-bottom:8px}
  .feat p{color:#9c9c9c;font-size:14px;line-height:1.5}
  .feat .num{font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--mute);letter-spacing:0.18em;margin-top:auto;padding-top:18px}
  @media (max-width:900px){.feat-grid{grid-template-columns:repeat(2,1fr)}}
  @media (max-width:560px){.feat-grid{grid-template-columns:1fr}}

  /* NUMBERS — outline/stroke */
  .numbers{padding:160px 0;background:var(--bg);position:relative;overflow:hidden}
  .numbers .court-overlay{position:absolute;inset:0;opacity:.07;pointer-events:none}
  .numbers-head{display:flex;justify-content:space-between;align-items:end;flex-wrap:wrap;gap:24px;margin-bottom:80px}
  .numbers-head h2{font-family:'Archivo Black',sans-serif;font-size:clamp(40px,6vw,88px);line-height:0.92;text-transform:uppercase;letter-spacing:-0.02em;max-width:14ch}
  .numbers-head h2 em{font-style:normal;color:var(--acc)}
  .numbers-head .legend{font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.16em;text-transform:uppercase;background:var(--acc);color:#000;padding:8px 14px;border-radius:999px;font-weight:700}
  .stats{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border-top:1px solid var(--line-2)}
  .stat{padding:48px 24px 32px;border-right:1px solid var(--line-2);position:relative}
  .stat:last-child{border-right:none}
  .stat .big{
    font-family:'Archivo Black',sans-serif;
    font-size:clamp(96px,16vw,260px);line-height:0.85;letter-spacing:-0.04em;
    color:transparent;
    -webkit-text-stroke:2px #fff;
    text-stroke:2px #fff;
    transition:color .4s ease,-webkit-text-stroke-color .4s ease;
  }
  .stat:hover .big{color:var(--acc);-webkit-text-stroke-color:var(--acc)}
  .stat .big sup{font-size:0.38em;vertical-align:top;display:inline-block;margin-left:6px}
  .stat .label{margin-top:24px;font-size:16px;line-height:1.35;max-width:24ch;color:#dcdcdc;font-weight:500}
  .stat .index{font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.18em;color:var(--mute);position:absolute;top:18px;left:24px}
  @media (max-width:900px){
    .stats{grid-template-columns:1fr}
    .stat{border-right:none;border-bottom:1px solid var(--line-2);padding:60px 0 36px}
    .stat:last-child{border-bottom:none}
  }
  .estimate-note{margin-top:48px;font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:0.04em;color:var(--mute);max-width:600px}
  .estimate-note strong{color:var(--acc);font-weight:600}

  /* HOW IT WORKS */
  .how{padding:140px 0 100px;background:var(--bg)}
  .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
  .step{background:#0d0d0d;border:1px solid var(--line);border-radius:20px;padding:36px;min-height:380px;display:flex;flex-direction:column;justify-content:space-between;position:relative;transition:transform .35s cubic-bezier(.2,.8,.2,1)}
  .step:hover{transform:translateY(-6px)}
  .step .step-num{font-family:'Archivo Black',sans-serif;font-size:160px;line-height:0.8;color:var(--acc);letter-spacing:-0.05em}
  .step h3{font-family:'Archivo Black',sans-serif;font-size:22px;line-height:1.04;text-transform:uppercase;letter-spacing:-0.01em;margin-bottom:12px}
  .step p{color:#9c9c9c;font-size:15px;line-height:1.5}
  .step .tag{position:absolute;top:32px;right:32px;font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.18em;color:var(--mute);text-transform:uppercase}
  @media (max-width:900px){.steps{grid-template-columns:1fr}}

  /* FORM */
  .form-section{padding:140px 0;background:var(--bg);position:relative;overflow:hidden}
  .form-section::before{content:"";position:absolute;top:-200px;right:-200px;width:600px;height:600px;border-radius:50%;background:radial-gradient(circle,rgba(204,255,0,.08),transparent 65%);pointer-events:none}
  .form-grid{display:grid;grid-template-columns:1.05fr 1fr;gap:80px;align-items:start;position:relative;z-index:2}
  .form-left h2{font-family:'Archivo Black',sans-serif;font-size:clamp(48px,7.2vw,118px);line-height:0.88;text-transform:uppercase;letter-spacing:-0.025em}
  .form-left h2 em{font-style:normal;color:var(--acc)}
  .form-left p{margin-top:28px;font-size:18px;line-height:1.45;color:#bdbdbd;max-width:480px}
  .form-left p strong{color:#fff;font-weight:700}
  .form-left .perks{margin-top:36px;display:flex;flex-direction:column;gap:14px}
  .form-left .perk{display:flex;align-items:center;gap:14px;font-size:15px;color:#dcdcdc}
  .form-left .perk .tick{width:22px;height:22px;border-radius:50%;background:var(--acc);color:#000;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;font-weight:700;font-size:13px}
  .form-left .slots{margin-top:42px;border-top:1px solid var(--line);padding-top:26px;display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap}
  .form-left .slots .label{font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:var(--mute)}
  .form-left .slots .counter{font-family:'Archivo Black',sans-serif;font-size:64px;line-height:1}
  .form-left .slots .counter em{font-style:normal;color:var(--acc)}
  .form-left .slots .bar{flex:1;min-width:200px;height:6px;background:#1a1a1a;border-radius:3px;overflow:hidden;position:relative}
  .form-left .slots .bar i{position:absolute;left:0;top:0;bottom:0;width:30%;background:var(--acc)}

  .form-card{background:#0d0d0d;border:1px solid var(--line);border-radius:24px;padding:40px;position:relative}
  .form-card .head{display:flex;align-items:center;justify-content:space-between;margin-bottom:28px;padding-bottom:20px;border-bottom:1px solid var(--line)}
  .form-card .head .title{font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:var(--mute)}
  .form-card .head .stat{display:flex;align-items:center;gap:8px;font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.14em;text-transform:uppercase;color:var(--acc)}
  .form-card .head .stat .pulse{width:6px;height:6px;border-radius:50%;background:var(--acc);animation:pulse 1.4s infinite}
  .field{display:flex;flex-direction:column;gap:8px;margin-bottom:18px}
  .field label{font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.16em;text-transform:uppercase;color:var(--mute)}
  .field input,.field select,.field textarea{background:#000;border:1px solid #1c1c1c;color:#fff;padding:16px 18px;border-radius:12px;font-size:15px;outline:none;transition:border-color .2s,background .2s;font-family:'DM Sans',sans-serif}
  .field input:focus,.field select:focus,.field textarea:focus{border-color:var(--acc);background:#0a0a0a}
  .field.error input,.field.error select{border-color:#ff5252}
  .field .err{font-family:'JetBrains Mono',monospace;font-size:10px;color:#ff5252;letter-spacing:0.08em;display:none}
  .field.error .err{display:block}
  .field-row{display:grid;grid-template-columns:1fr 1fr;gap:14px}
  .form-submit{margin-top:8px;width:100%;background:var(--acc);color:#000;padding:22px;border-radius:14px;font-family:'Archivo Black',sans-serif;font-size:15px;letter-spacing:0.06em;text-transform:uppercase;display:flex;align-items:center;justify-content:center;gap:14px;transition:transform .25s cubic-bezier(.2,.8,.2,1)}
  .form-submit:hover{transform:translateY(-2px)}
  .form-submit:disabled{opacity:.6;cursor:wait;transform:none}
  .form-fine{margin-top:14px;font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--mute);letter-spacing:0.04em;text-align:center}
  .form-card .corner{position:absolute;top:-1px;right:-1px;width:80px;height:80px;border-top:1px solid var(--acc);border-right:1px solid var(--acc);border-top-right-radius:24px;opacity:.5;pointer-events:none}
  @media (max-width:1000px){.form-grid{grid-template-columns:1fr;gap:48px}}
  @media (max-width:560px){.field-row{grid-template-columns:1fr}}

  /* FOOTER */
  footer{padding:60px 0 40px;background:var(--bg);border-top:1px solid var(--line)}
  .foot-grid{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:20px}
  .foot-logo{display:flex;align-items:center;gap:12px;font-family:'Archivo Black',sans-serif;font-size:20px}
  .foot-logo .dot{width:8px;height:8px;background:var(--acc);border-radius:50%;box-shadow:0 0 12px var(--acc)}
  .foot-meta{font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.14em;color:var(--mute);text-transform:uppercase}
  .foot-tag{font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.14em;color:#dcdcdc;text-transform:uppercase}
  .foot-tag span{color:var(--acc)}

  /* Animation utils */
  .reveal{opacity:0;transform:translateY(40px);transition:opacity .9s cubic-bezier(.2,.8,.2,1),transform .9s cubic-bezier(.2,.8,.2,1)}
  .reveal.in{opacity:1;transform:translateY(0)}
  .reveal.d1{transition-delay:.08s}
  .reveal.d2{transition-delay:.16s}
  .reveal.d3{transition-delay:.24s}
  .reveal.d4{transition-delay:.32s}
  .reveal.d5{transition-delay:.4s}
  .reveal.d6{transition-delay:.48s}

  .bubble.reveal{opacity:0;transform:translateY(10px) scale(.98)}
  .bubble.reveal.in{opacity:1;transform:translateY(0) scale(1)}

  /* Success state */
  .success{display:none;text-align:center;padding:30px 0}
  .success.show{display:block}
  .success .check{width:80px;height:80px;border-radius:50%;background:var(--acc);color:#000;display:inline-flex;align-items:center;justify-content:center;margin-bottom:24px}
  .success .check svg{width:36px;height:36px;stroke:#000;stroke-width:3;fill:none;stroke-linecap:round;stroke-linejoin:round}
  .success h3{font-family:'Archivo Black',sans-serif;font-size:32px;text-transform:uppercase;margin-bottom:12px;line-height:1.05}
  .success p{color:#bdbdbd;font-size:15px;line-height:1.5;max-width:380px;margin:0 auto}
  .success .ball{display:inline-block;font-size:24px;margin-left:6px}

  /* Accessibility — focus visible */
  a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible{outline:2px solid var(--acc);outline-offset:3px;border-radius:6px}

  @media (prefers-reduced-motion:reduce){
    *,*::before,*::after{animation-duration:.01ms !important;transition-duration:.01ms !important;animation-iteration-count:1 !important}
    .reveal{opacity:1;transform:none}
  }
</style>
</head>
