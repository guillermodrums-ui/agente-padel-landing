  let currentLang = 'pt';

  function i18nGet(dict, key){
    if(dict[key] != null) return dict[key];
    if(I18N.pt[key] != null){ console.warn('[i18n] missing "' + key + '" for current lang — falling back to PT'); return I18N.pt[key]; }
    console.warn('[i18n] unknown key:', key);
    return '';
  }

  function applyLang(lang){
    if(lang !== 'es' && lang !== 'pt') lang = 'pt';
    currentLang = lang;
    const dict = I18N[lang] || I18N.pt;
    document.querySelectorAll('[data-i18n]').forEach(function(el){
      el.textContent = i18nGet(dict, el.getAttribute('data-i18n'));
    });
    document.querySelectorAll('[data-i18n-html]').forEach(function(el){
      el.innerHTML = i18nGet(dict, el.getAttribute('data-i18n-html'));
    });
    ['placeholder','aria-label','content','title'].forEach(function(attr){
      document.querySelectorAll('[data-i18n-attr-' + attr + ']').forEach(function(el){
        el.setAttribute(attr, i18nGet(dict, el.getAttribute('data-i18n-attr-' + attr)));
      });
    });
    document.documentElement.lang = (lang === 'es') ? 'es-AR' : 'pt-BR';
    document.querySelectorAll('.lang-btn').forEach(function(b){
      b.setAttribute('aria-pressed', String(b.getAttribute('data-lang') === lang));
    });
  }

  function detectLang(){
    try {
      const saved = localStorage.getItem('saque_lang');
      if(saved === 'pt' || saved === 'es') return saved;
    } catch(e){}
    const navLang = (navigator.language || navigator.userLanguage || 'pt').toLowerCase();
    return navLang.indexOf('es') === 0 ? 'es' : 'pt';
  }

  function setLang(lang){
    try { localStorage.setItem('saque_lang', lang); } catch(e){}
    applyLang(lang);
  }

  document.querySelectorAll('.lang-btn').forEach(function(btn){
    btn.addEventListener('click', function(){ setLang(btn.getAttribute('data-lang')); });
  });

  // Apply detected language ASAP. PT is server-rendered → PT visitors get zero repaint.
  applyLang(detectLang());

  // Reveal on scroll
  const io = new IntersectionObserver((entries)=>{
    entries.forEach(e=>{
      if(e.isIntersecting){
        e.target.classList.add('in');
        io.unobserve(e.target);
      }
    });
  },{threshold:0.12});
  document.querySelectorAll('.reveal').forEach(el=>io.observe(el));

  // Custom cursor
  if (matchMedia('(hover:hover) and (pointer:fine)').matches) {
    const cur = document.getElementById('cursor');
    let x=0,y=0,tx=0,ty=0;
    document.addEventListener('mousemove',(e)=>{tx=e.clientX;ty=e.clientY});
    function loop(){x+=(tx-x)*0.25;y+=(ty-y)*0.25;cur.style.transform=`translate(${x}px,${y}px) translate(-50%,-50%)`;requestAnimationFrame(loop);}
    loop();
    document.querySelectorAll('a,button,input,select,textarea,.phone').forEach(el=>{
      el.addEventListener('mouseenter',()=>cur.classList.add('lg'));
      el.addEventListener('mouseleave',()=>cur.classList.remove('lg'));
    });
  }

  // Phone mask — BR keeps the strict (DDD) format; ES (Argentina) uses a permissive soft mask
  // so AR numbers (+54 9 11 ..., 10–13 digits, varied formats) are never silently rejected.
  const whats = document.getElementById('whats');
  function maskPhone(v){
    v = v.replace(/\D/g,'').slice(0,11);
    if(v.length<=2) return v.length? '('+v : '';
    if(v.length<=6) return '('+v.slice(0,2)+') '+v.slice(2);
    if(v.length<=10) return '('+v.slice(0,2)+') '+v.slice(2,6)+'-'+v.slice(6);
    return '('+v.slice(0,2)+') '+v.slice(2,7)+'-'+v.slice(7);
  }
  // Soft mask for AR: keep digits + common separators, allow a single leading '+', don't impose any pattern.
  function maskPhoneAR(v){
    let cleaned = v.replace(/[^\d+\s()\-]/g,'');
    cleaned = cleaned.replace(/(?!^)\+/g,''); // only one '+', only at the start
    return cleaned.slice(0,20);
  }
  whats.addEventListener('input',(e)=>{
    e.target.value = (currentLang === 'es') ? maskPhoneAR(e.target.value) : maskPhone(e.target.value);
  });

  // Phone validation — BR requires 10/11 digits; ES (AR) accepts 8–15 digits (with optional +).
  function validPhone(v){
    const d = v.replace(/\D/g,'');
    return d.length===10 || d.length===11;
  }
  function validPhoneAR(v){
    const d = v.replace(/\D/g,'');
    return d.length>=8 && d.length<=15;
  }
  function isPhoneValid(v){
    return (currentLang === 'es') ? validPhoneAR(v) : validPhone(v);
  }

  // Form submit
  const form = document.getElementById('leadForm');
  const submitBtn = document.getElementById('submitBtn');
  const submitLabel = document.getElementById('submitLabel');
  const formStatus = document.getElementById('formStatus');

  form.addEventListener('submit', async (e)=>{
    e.preventDefault();
    // clear errors
    form.querySelectorAll('.field').forEach(f=>f.classList.remove('error'));

    const nome = document.getElementById('nome');
    const clube = document.getElementById('clube');
    const cidade = document.getElementById('cidade');

    let ok = true;
    if(!nome.value.trim()){ nome.closest('.field').classList.add('error'); ok=false; }
    if(!isPhoneValid(whats.value)){ whats.closest('.field').classList.add('error'); ok=false; }
    if(!clube.value.trim()){ clube.closest('.field').classList.add('error'); ok=false; }
    // cidade is optional
    if(!ok){
      const firstErr = form.querySelector('.field.error input, .field.error select');
      if(firstErr) firstErr.focus();
      return;
    }

    submitBtn.disabled = true;
    submitLabel.textContent = I18N[currentLang]['form.submit.sending'];
    formStatus.textContent = I18N[currentLang]['form.status.sending'];

    const data = {
      nome: nome.value.trim(),
      whatsapp: whats.value.trim(),
      clube: clube.value.trim(),
      cidade: cidade.value.trim(),
      origem: 'landing-saque',
      timestamp: new Date().toISOString()
    };

    // 1) WhatsApp link — open immediately on click to avoid popup blockers
    const waMsg = (currentLang === 'es')
      ? `¡Hola! Soy ${data.nome} del club ${data.clube}${data.cidade ? ' en ' + data.cidade : ''}. Quiero entrar a la lista de pilotos de Saque.`
      : `Olá! Sou ${data.nome} do clube ${data.clube}${data.cidade ? ' em ' + data.cidade : ''}. Quero entrar na lista dos pilotos do Saque.`;
    // AR leads go to the AR number placeholder until Guille wires the real one (see WA_NUMBER_AR).
    const waTarget = (currentLang === 'es') ? WA_NUMBER_AR : WA_NUMBER;
    const waUrl = `https://wa.me/${waTarget}?text=${encodeURIComponent(waMsg)}`;
    const waWin = window.open(waUrl, '_blank', 'noopener');

    // 2) Send to Formspree (parallel)
    try {
      await fetch(FORMSPREE_ENDPOINT, {
        method:'POST',
        headers:{'Content-Type':'application/json','Accept':'application/json'},
        body: JSON.stringify(data)
      });
    } catch(err) {
      console.warn('Formspree submit failed silently:', err);
    }

    // 3) Show success
    document.getElementById('formBody').style.display = 'none';
    document.getElementById('success').classList.add('show');
    formStatus.textContent = I18N[currentLang]['form.status.received'];

    // Fallback: if popup blocked, give a clickable link in success
    if(!waWin){
      const link = document.createElement('a');
      link.href = waUrl; link.target = '_blank'; link.rel = 'noopener';
      link.textContent = I18N[currentLang]['form.wa.fallback'];
      link.style.cssText = 'display:inline-block;margin-top:18px;background:var(--acc);color:#000;padding:12px 18px;border-radius:999px;font-family:Archivo Black,sans-serif;font-size:13px;letter-spacing:.06em';
      document.getElementById('success').appendChild(link);
    }
  });

  // Tiny parallax on hero court bg
  const courtBg = document.querySelector('.court-bg');
  window.addEventListener('scroll',()=>{
    const y = window.scrollY;
    if(y<900 && courtBg) courtBg.style.transform = `translateY(${y*0.18}px)`;
  },{passive:true});
</script>

