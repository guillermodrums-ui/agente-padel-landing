# Railway env vars — set in the Railway dashboard for the `landing` service.

# WhatsApp number for the lead form CTA. Digits only, with country code.
# Example: 5551999998888
WA_NUMBER=55999089118

# Formspree endpoint for the lead form POST.
# Get yours at https://formspree.io/forms — format: https://formspree.io/f/xxxxxxxxx
FORMSPREE_ENDPOINT=https://formspree.io/f/REPLACE_ME

# Railway sets PORT automatically (defaults to 8080). Override only if needed.
# PORT=8080
